{
  "name": "710-wiki",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "quartz-site",
    "proxy"
  ],
  "scripts": {
    "format:frontmatter": "node scripts/format-frontmatter.mjs",
    "lint:frontmatter": "node scripts/format-frontmatter.mjs --check",
    "validate:canvases": "node scripts/validate-canvases.mjs",
  "build": "npm run format:frontmatter && npm run lint:frontmatter && npm run validate:canvases && npm run build -w quartz-site && npm run build -w proxy",
  "start": "node proxy/dist/server.js",
    "oracle:proxy": "node scripts/oracle-proxy.mjs"
  },
  "dependencies": {
    "serve": "^14.2.1",
    "yaml": "^2.6.0"
  }
}
